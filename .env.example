# Copy to .env and fill in real values. Never commit .env.

# OpenAI-compatible API (OpenAI, Azure OpenAI, Together, Groq, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama local (no key needed by default)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional default judge model for LLM-as-judge scoring
LLM_EVAL_JUDGE_MODEL=gpt-4o-mini

# SQLite results DB path (default: ./results/evals.db)
LLM_EVAL_DB_PATH=./results/evals.db
